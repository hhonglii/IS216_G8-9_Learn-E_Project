PORT=8000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=
# Optional GitHub token: keep it server-side and never expose it in client code.
GITHUB_TOKEN=
# Optional Gemini API key and model for professor hint drafts (decisions B-13, B-14).
# Get a key at aistudio.google.com; pick a current free-tier model from
# ai.google.dev/gemini-api/docs/pricing. Leaving either empty makes hint drafts answer
# 503 HINT_DRAFTS_UNAVAILABLE; the rest of the app still works.
GEMINI_API_KEY=
GEMINI_MODEL=
# Code a person must type to create a professor account (decision G-14). Share it
# privately with the team. Left empty, no professor account can be created.
PROFESSOR_SIGNUP_CODE=
